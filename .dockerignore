# Git & Version Control
.git
.gitignore

# Environment & Local Configuration
.env
.env.*
!.env.example

# Local Dependencies (Composer install runs inside Docker)
/vendor
/node_modules

# Build Assets & Frontend Bundling
/public/build
/public/storage
npm-debug.log
yarn-error.log

# Storage & Logs
/storage/*.key
/storage/logs/*
!.storage/logs/.gitkeep
/storage/framework/cache/*
!.storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!.storage/framework/sessions/.gitkeep
/storage/framework/views/*
!.storage/framework/views/.gitkeep

# IDE & OS Metadata
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Testing & CI
/tests
phpunit.xml
.phpunit.result.cache
